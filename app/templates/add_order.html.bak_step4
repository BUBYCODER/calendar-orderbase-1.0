{% extends "base.html" %}
{% block title %}Создать заказ{% endblock %}
{% block content %}

<div style="margin-bottom: 20px;">
    <a href="/orders" class="btn btn-outline" style="display:inline-flex; align-items:center; gap:6px; font-weight:600;">
        ← Назад
    </a>
</div>

<div class="form-container">
    <form method="POST" action="/add_order" id="orderForm" enctype="multipart/form-data" novalidate>
        <input type="hidden" name="loaded_draft_id" id="loaded_draft_id">
        
        <!-- ПАСПОРТ ЗАКАЗА -->
        <div class="form-block-card">
            <h3 style="margin-bottom: 15px; font-size: 16px; font-weight: 600;">Паспорт заказа</h3>
            
            <div style="display: flex; gap: 15px; flex-wrap: wrap; margin-bottom: 15px;">
                <div class="form-group" style="flex: 1; min-width: 140px;">
                    <label class="field-title">Номер заказа *</label>
                    <input type="number" name="order_number" id="order_number" value="{{ next_num }}" min="1" required oninput="checkOrderNumber(this.value)">
                    <div id="order-number-status" style="font-size: 11px; margin-top: 4px; font-weight:600; color:#dc2626;"></div>
                </div>
                <div class="form-group" style="flex: 1; min-width: 160px;">
                    <label class="field-title">Клиент / Бренд *</label>
                    <input type="text" name="client_name" id="client_name" list="clients-datalist" placeholder="Выберите или введите..." required oninput="clearFieldError(this)">
                    <datalist id="clients-datalist">
                        {% for c in clients %}
                        <option value="{{ c.name }}">
                        {% endfor %}
                    </datalist>
                    <div class="field-error-text" style="display:none; color:#dc2626; font-size:12px; margin-top:4px;">Это поле обязательное</div>
                </div>
                <div class="form-group" id="group-name" style="flex: 2; min-width: 240px;">
                    <label class="field-title">Название заказа *</label>
                    <input type="text" name="name" id="order-name" placeholder="Например: Худи Оверсайз черные для бренда X" autofocus oninput="clearFieldError(this)">
                    <div class="field-error-text" style="display:none; color:#dc2626; font-size:12px; margin-top:4px;">Это поле обязательное</div>
                </div>
            </div>

            <div style="display: flex; gap: 15px; flex-wrap: wrap; margin-bottom: 15px;">
                <div class="form-group" style="flex: 1; min-width: 150px;">
                    <label class="field-title">Дата оформления *</label>
                    <input type="date" name="creation_date" id="creation_date" value="{{ today_str }}" required>
                </div>
                <div class="form-group" style="flex: 1; min-width: 160px;">
                    <label class="field-title">Общая сумма заказа (₽)</label>
                    <input type="number" name="amount" id="order_amount" min="0" step="100" placeholder="0">
                </div>
                <div class="form-group" style="flex: 1; min-width: 140px;">
                    <label class="field-title">Тип заказа</label>
                    <select name="order_type" id="order_type" onchange="toggleOrderTypeUI(); loadOccupiedSlots();">
                        <option value="batch">Основная партия</option>
                        <option value="sample">Образец</option>
                    </select>
                </div>
                <div class="form-group" style="flex: 1; min-width: 180px;">
                    <label class="field-title">Контакты</label>
                    <input type="text" name="contact" id="contact_input" placeholder="+7 999 000-00-00 или @telegram">
                </div>
            </div>

            <div class="form-group" style="margin-bottom: 0;">
                <label class="field-title">Комментарий к заказу</label>
                <input type="text" name="comment" id="order-comment" placeholder="Дополнительные пожелания, заметки для цеха..." autocomplete="off">
            </div>
        </div>

        <!-- СОСТАВ ЗАКАЗА (Пункты 8, 9, 10, 12 ТЗ) -->
        <div class="form-block-card" id="block-positions">
            <h3 style="margin: 0 0 15px 0; font-size: 16px; font-weight: 600;">Состав заказа</h3>

            <div id="positions-container"></div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 15px; flex-wrap: wrap; gap: 10px; border-top: 1px dashed #262626; padding-top: 12px;">
                <button type="button" class="btn btn-outline" onclick="addPositionCard()">+ Добавить еще изделие в этот заказ</button>
                <div class="order-total-bar">
                    ОБЩИЙ ТИРАЖ ЗАКАЗА: <span id="total-order-qty">0</span> шт.
                </div>
            </div>
            <input type="hidden" name="quantity" id="hidden_total_quantity" value="0">
        </div>

        <!-- ПРОИЗВОДСТВЕННЫЙ ГРАФИК (Пункты 4, 5, 11 ТЗ: точный финиш, без тех.строки) -->
        <div class="form-block-card">
            <h3 style="margin-bottom: 15px; font-size: 16px; font-weight: 600;">Производственный график</h3>

            <div class="form-group" id="group-start-date" style="margin-bottom: 20px;">
                <label class="field-title">Дата начала производства: *</label>
                <div style="display: flex; align-items: center; gap: 15px; flex-wrap: wrap;">
                    <button type="button" class="btn btn-outline" id="start-picker-btn" onclick="openStartPicker()">Выбрать дату и часть дня</button>
                    <span id="order-start-display" class="start-date-display">(не выбрано)</span>
                    <span id="order-finish-display" class="start-date-display" style="display: none; color: #a3a3a3 !important;"></span>
                </div>
                <input type="hidden" name="order_start_date" id="global-start-date">
                <input type="hidden" name="order_start_q" id="global-start-q">
                <div class="field-error-text" style="display:none; color:#dc2626; font-size:12px; margin-top:4px;">Выберите дату начала производства</div>
            </div>

            <div id="batch-ui">
                <div id="group-batch-stages">
                    <ul id="sortable-stages" style="list-style: none; padding: 0;"></ul>
                    <div class="field-error-text" id="batch-stages-error" style="display:none; color:#dc2626; font-size:12px; margin-top:4px;">Добавьте хотя бы один этап производства</div>
                </div>

                <!-- Пункт 11 ТЗ: только кнопка добавления этапа -->
                <div style="position: relative; display: inline-block; margin-top: 10px;">
                    <button type="button" class="btn btn-outline" onclick="toggleStageMenu(event)" style="font-weight: 600;">+ Добавить этап ▾</button>
                    <div id="stageDropdownMenu" class="stage-dropdown-menu">
                        <div class="stage-dropdown-item" onclick="addStageFromMenu('Раскрой')">Раскрой</div>
                        <div class="stage-dropdown-item" onclick="addStageFromMenu('Пошив')">Пошив</div>
                        <div class="stage-dropdown-item" onclick="addStageFromMenu('DTF')">DTF</div>
                        <div class="stage-dropdown-item" onclick="addStageFromMenu('Шелкография')">Шелкография</div>
                        <div class="stage-dropdown-item" onclick="addStageFromMenu('Вышивка')">Вышивка</div>
                        <div class="stage-dropdown-item" onclick="addStageFromMenu('ВТО и упаковка')">ВТО и упаковка</div>
                        <div class="stage-dropdown-item" onclick="addStageFromMenu('Отгрузка')">Отгрузка</div>
                        <div class="stage-dropdown-divider"></div>
                        <div class="stage-dropdown-item" onclick="promptCustomStage()">+ Свой этап...</div>
                    </div>
                </div>
            </div>

            <div id="sample-ui" style="display:none; margin-top:15px;">
                <div class="form-group sample-duration-box" id="group-sample-duration">
                    <label class="field-title">Общая длительность пошива образца *</label>
                    <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                        <select id="sample-duration" style="width: auto; max-width: 200px;" onchange="calculateSampleSchedule();">
                            <option value="">Выберите...</option>
                            <option value="0.25">0.25 дня</option>
                            <option value="0.5">0.5 дня</option>
                            <option value="1">1 день</option>
                            <option value="2">2 дня</option>
                            <option value="3">3 дня</option>
                            <option value="4">4 дня</option>
                            <option value="5">5 дней</option>
                            <option value="6">6 дней</option>
                            <option value="7">7 дней</option>
                        </select>
                        <span id="sample-dates-display" style="font-size: 13px; font-weight:600; color:#58a6ff;"></span>
                    </div>
                    <input type="hidden" name="sample_end_date" id="sample-end-date">
                    <input type="hidden" name="sample_end_q" id="sample-end-q">
                </div>
            </div>
        </div>
        
        <div class="form-actions" style="margin-top:25px; display:flex; gap:12px;">
            <button type="button" class="btn btn-primary" style="padding: 9px 24px; font-size: 15px;" onclick="openOrderSummaryModal()">Создать заказ</button>
            <button type="button" class="btn btn-outline" id="btn-save-draft" onclick="saveCurrentAsDraft()">В черновики</button>
            <a href="/orders" class="btn btn-outline" style="padding: 9px 20px;">Отмена</a>
        </div>
    </form>
</div>

<!-- МОДАЛЬНОЕ ОКНО СВОДКИ (Пункт 4 ТЗ: нанесения и финиш) -->
<div id="summaryModal" class="modal-overlay" onclick="if(event.target===this) closeSummaryModal()">
    <div class="modal-content" style="max-width: 720px;">
        <span class="modal-close" onclick="closeSummaryModal()">&times;</span>
        <h3 style="margin-bottom: 5px; color: #58a6ff;">Подтверждение создания заказа</h3>
        <p style="font-size: 13px; color: #8b949e; margin-bottom: 15px;">Проверьте введённые данные перед окончательным сохранением.</p>
        
        <div id="summaryContent" style="font-size: 14px; line-height: 1.5; max-height: 60vh; overflow-y: auto; padding-right: 5px;"></div>
        
        <div style="display: flex; gap: 12px; justify-content: flex-end; margin-top: 20px; border-top: 1px solid #262626; padding-top: 15px;">
            <button type="button" class="btn btn-outline" onclick="closeSummaryModal()">Вернуться к редактированию</button>
            <button type="button" class="btn btn-primary" style="padding: 8px 22px;" onclick="submitOrderFormFinal()">Подтвердить и создать</button>
        </div>
    </div>
</div>

<!-- КАЛЕНДАРНЫЙ ПИКЕР -->
<div id="calendarModal" class="modal-overlay" onclick="if(event.target===this) closePicker()">
    <div class="modal-content" style="max-width: 600px;">
        <span class="modal-close" onclick="closePicker()">&times;</span>
        <h3 id="pickerTitle">Выберите дату</h3>
        <div style="display:flex; justify-content:space-between; margin:15px 0;">
            <button type="button" class="btn btn-outline" onclick="changeMonth(-1)">←</button>
            <strong id="pickerMonthYear"></strong>
            <button type="button" class="btn btn-outline" onclick="changeMonth(1)">→</button>
        </div>
        <div style="display:grid; grid-template-columns:repeat(7,1fr); text-align:center; font-weight:bold; margin-bottom:5px;">
            <div>Пн</div><div>Вт</div><div>Ср</div><div>Чт</div><div>Пт</div><div>Сб</div><div>Вс</div>
        </div>
        <div id="pickerGrid" style="display:grid; grid-template-columns:repeat(7,1fr); gap:4px;"></div>
        <div style="margin-top:15px; text-align:right;">
            <button type="button" class="btn btn-primary" onclick="applyPicker()">Применить</button>
        </div>
    </div>
</div>

<script>
    const PRODUCTS_LIST = [
        'Худи', 'Зип-худи', 'Свитшот', 'Полузамок', 'Олимпийка',
        'Бомбер', 'Брюки', 'Футболка', 'Лонгслив', 'Майка', 'Шорты', 'Свой вариант'
    ];

    const PATTERNS_MAP = {
        'Худи': ['Oversize', 'Boxy-fit', 'Regular'],
        'Зип-худи': ['Oversize', 'Boxy-fit', 'Regular'],
        'Свитшот': ['Oversize', 'Boxy-fit', 'Regular'],
        'Полузамок': ['Oversize', 'Boxy-fit', 'Regular'],
        'Олимпийка': ['Oversize', 'Boxy-fit', 'Regular'],
        'Бомбер': ['Oversize', 'Boxy-fit', 'Regular'],
        'Футболка': ['Oversize', 'Boxy-fit', 'Regular', 'Slim'],
        'Лонгслив': ['Oversize', 'Boxy-fit', 'Regular', 'Slim'],
        'Майка': ['Oversize', 'Boxy-fit', 'Regular', 'Slim'],
        'Брюки': ['Джоггеры', 'Прямые', 'Oversize'],
        'Шорты': ['Oversize']
    };

    const FABRICS_LIST = ['3-х нитка Петля', '3-х нитка Начес', '2х нитка Петля', 'Кулирная гладь', 'Свой вариант'];

    const DENSITIES_MAP = {
        '3-х нитка Петля': ['340г', '420г', '500г'],
        '3-х нитка Начес': ['340г'],
        '2х нитка Петля': ['240г'],
        'Кулирная гладь': ['190г', '220г', '240г', '300г']
    };

    const COLORS_LIST = ['Черный', 'Белый', 'Молочный', 'Темно-синий', 'Василек', 'Бордовый', 'Свой вариант'];

    let positionCounter = 0;

    
    function stepSizeInput(btn, step) {
        const box = btn.closest('.size-cell-box');
        const inp = box.querySelector('.size-input');
        let val = parseInt(inp.value || 0, 10) || 0;
        val = Math.max(0, val + step);
        inp.value = val;
        inp.dispatchEvent(new Event('input', { bubbles: true }));
    }

        function updateDeleteButtonsVisibility() {
        const container = document.getElementById('positions-container');
        const cards = container ? container.querySelectorAll('.position-card') : [];
        if (container) {
            if (cards.length > 1) {
                container.classList.add('show-delete-btn');
            } else {
                container.classList.remove('show-delete-btn');
            }
        }
    }
    function addPositionCard() {
        positionCounter++;
        const pId = positionCounter;
        const container = document.getElementById('positions-container');

        const card = document.createElement('div');
        card.className = 'position-card';
        card.id = `pos-card-${pId}`;
        card.dataset.pid = pId;

        card.innerHTML = `
            <input type="hidden" name="pos_index[]" value="${pId}">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px; border-bottom:1px solid #262626; padding-bottom:8px;">
                <span class="pos-header-title">Позиция #${pId}</span>
                <button type="button" class="btn btn-danger pos-delete-btn" style="padding:3px 8px; font-size:12px;" onclick="removePositionCard(this)">Удалить позицию</button>
            </div>

            <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap:12px; margin-bottom:12px;">
                <!-- Вид изделия -->
                <div>
                    <label class="field-title" style="display:block; margin-bottom:4px;">Вид изделия *</label>
                    <div id="wrap_product_${pId}">
                        <select name="product_${pId}" id="product_${pId}" onchange="handleFieldCustomChoice(${pId}, 'product', this.value)" required>
                            <option value="">Выберите изделие...</option>
                            ${PRODUCTS_LIST.map(p => `<option value="${p}">${p}</option>`).join('')}
                        </select>
                        <div class="custom-replace-box" id="custom_box_product_${pId}" style="display:none;">
                            <input type="text" id="custom_product_${pId}" placeholder="Введите изделие...">
                            <button type="button" class="btn-close-custom" onclick="revertFieldToSelect(${pId}, 'product')" title="Вернуться к списку">✕</button>
                        </div>
                    </div>
                </div>

                <!-- Лекала / Фит -->
                <div>
                    <label class="field-title" style="display:block; margin-bottom:4px;">Лекала / Фит *</label>
                    <div id="wrap_pattern_${pId}">
                        <select name="pattern_${pId}" id="pattern_${pId}" onchange="handleFieldCustomChoice(${pId}, 'pattern', this.value)">
                            <option value="">Сначала выберите изделие</option>
                        </select>
                        <div class="custom-replace-box" id="custom_box_pattern_${pId}" style="display:none;">
                            <input type="text" id="custom_pattern_${pId}" placeholder="Введите лекало...">
                            <button type="button" class="btn-close-custom" onclick="revertFieldToSelect(${pId}, 'pattern')" title="Вернуться к списку">✕</button>
                        </div>
                    </div>
                </div>

                <!-- Полотно -->
                <div>
                    <label class="field-title" style="display:block; margin-bottom:4px;">Полотно *</label>
                    <div id="wrap_fabric_${pId}">
                        <select name="fabric_${pId}" id="fabric_${pId}" onchange="handleFieldCustomChoice(${pId}, 'fabric', this.value)">
                            <option value="">Выберите полотно...</option>
                            ${FABRICS_LIST.map(f => `<option value="${f}">${f}</option>`).join('')}
                        </select>
                        <div class="custom-replace-box" id="custom_box_fabric_${pId}" style="display:none;">
                            <input type="text" id="custom_fabric_${pId}" placeholder="Введите полотно...">
                            <button type="button" class="btn-close-custom" onclick="revertFieldToSelect(${pId}, 'fabric')" title="Вернуться к списку">✕</button>
                        </div>
                    </div>
                </div>

                <!-- Плотность -->
                <div>
                    <label class="field-title" style="display:block; margin-bottom:4px;">Плотность</label>
                    <div id="wrap_density_${pId}">
                        <select name="density_${pId}" id="density_${pId}" onchange="handleFieldCustomChoice(${pId}, 'density', this.value)">
                            <option value="">Сначала полотно</option>
                        </select>
                        <div class="custom-replace-box" id="custom_box_density_${pId}" style="display:none;">
                            <input type="text" id="custom_density_${pId}" placeholder="Введите плотность...">
                            <button type="button" class="btn-close-custom" onclick="revertFieldToSelect(${pId}, 'density')" title="Вернуться к списку">✕</button>
                        </div>
                    </div>
                </div>

                <!-- Цвет полотна -->
                <div>
                    <label class="field-title" style="display:block; margin-bottom:4px;">Цвет полотна</label>
                    <div id="wrap_color_${pId}">
                        <select name="color_${pId}" id="color_${pId}" onchange="handleFieldCustomChoice(${pId}, 'color', this.value)">
                            ${COLORS_LIST.map(c => `<option value="${c}">${c}</option>`).join('')}
                        </select>
                        <div class="custom-replace-box" id="custom_box_color_${pId}" style="display:none;">
                            <input type="text" id="custom_color_${pId}" placeholder="Введите цвет...">
                            <button type="button" class="btn-close-custom" onclick="revertFieldToSelect(${pId}, 'color')" title="Вернуться к списку">✕</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Размерная сетка -->
            <div style="margin-bottom:12px;">
                <label class="field-title" style="display:block; margin-bottom:4px;">Размерная сетка:</label>
                <div class="size-grid-wrapper">
                    <table class="size-table">
                        <thead>
                            <tr>
                                <th>3XS</th><th>2XS</th><th>XS</th><th>S</th><th>M</th>
                                <th>L</th><th>XL</th><th>2XL</th><th>3XL</th>
                                <th class="pos-total-cell">ИТОГО ПОЗ.</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><div class="size-cell-box"><button type="button" class="stepper-btn minus" onclick="stepSizeInput(this, -1)">−</button><input type="number" name="size_3xs_${pId}" min="0" value="0" class="size-input" oninput="recalcPositionTotal(${pId})"><button type="button" class="stepper-btn plus" onclick="stepSizeInput(this, 1)">+</button></div></td>
                                <td><div class="size-cell-box"><button type="button" class="stepper-btn minus" onclick="stepSizeInput(this, -1)">−</button><input type="number" name="size_2xs_${pId}" min="0" value="0" class="size-input" oninput="recalcPositionTotal(${pId})"><button type="button" class="stepper-btn plus" onclick="stepSizeInput(this, 1)">+</button></div></td>
                                <td><div class="size-cell-box"><button type="button" class="stepper-btn minus" onclick="stepSizeInput(this, -1)">−</button><input type="number" name="size_xs_${pId}" min="0" value="0" class="size-input" oninput="recalcPositionTotal(${pId})"><button type="button" class="stepper-btn plus" onclick="stepSizeInput(this, 1)">+</button></div></td>
                                <td><div class="size-cell-box"><button type="button" class="stepper-btn minus" onclick="stepSizeInput(this, -1)">−</button><input type="number" name="size_s_${pId}" min="0" value="0" class="size-input" oninput="recalcPositionTotal(${pId})"><button type="button" class="stepper-btn plus" onclick="stepSizeInput(this, 1)">+</button></div></td>
                                <td><div class="size-cell-box"><button type="button" class="stepper-btn minus" onclick="stepSizeInput(this, -1)">−</button><input type="number" name="size_m_${pId}" min="0" value="0" class="size-input" oninput="recalcPositionTotal(${pId})"><button type="button" class="stepper-btn plus" onclick="stepSizeInput(this, 1)">+</button></div></td>
                                <td><div class="size-cell-box"><button type="button" class="stepper-btn minus" onclick="stepSizeInput(this, -1)">−</button><input type="number" name="size_l_${pId}" min="0" value="0" class="size-input" oninput="recalcPositionTotal(${pId})"><button type="button" class="stepper-btn plus" onclick="stepSizeInput(this, 1)">+</button></div></td>
                                <td><div class="size-cell-box"><button type="button" class="stepper-btn minus" onclick="stepSizeInput(this, -1)">−</button><input type="number" name="size_xl_${pId}" min="0" value="0" class="size-input" oninput="recalcPositionTotal(${pId})"><button type="button" class="stepper-btn plus" onclick="stepSizeInput(this, 1)">+</button></div></td>
                                <td><div class="size-cell-box"><button type="button" class="stepper-btn minus" onclick="stepSizeInput(this, -1)">−</button><input type="number" name="size_2xl_${pId}" min="0" value="0" class="size-input" oninput="recalcPositionTotal(${pId})"><button type="button" class="stepper-btn plus" onclick="stepSizeInput(this, 1)">+</button></div></td>
                                <td><div class="size-cell-box"><button type="button" class="stepper-btn minus" onclick="stepSizeInput(this, -1)">−</button><input type="number" name="size_3xl_${pId}" min="0" value="0" class="size-input" oninput="recalcPositionTotal(${pId})"><button type="button" class="stepper-btn plus" onclick="stepSizeInput(this, 1)">+</button></div></td>
                                <td class="pos-total-cell" style="text-align:center;" id="pos-total-display-${pId}">0 шт.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Нанесения -->
            <div style="margin-bottom:12px;">
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:6px;">
                    <label class="field-title" style="margin:0;">Нанесения на изделие:</label>
                    <button type="button" class="btn btn-outline" style="padding:2px 8px; font-size:11px;" onclick="addEmbellishmentRow(${pId})">+ Добавить нанесение</button>
                </div>
                <div id="embellishments-container-${pId}" style="display:flex; flex-direction:column; gap:6px;"></div>
            </div>

            <!-- Файлы к позиции -->
            <div>
                <label class="field-title" style="display:block; margin-bottom:4px;">Макеты / файлы позиции:</label>
                <input type="file" name="pos_files_${pId}" multiple accept="image/*,.pdf,.ai,.psd">
            </div>
        `;

        container.appendChild(card);
        updateDeleteButtonsVisibility();
        recalcGlobalTotal();
    }

    // Замена селекта на текстовое поле при выборе "Свой вариант"
    function handleFieldCustomChoice(pId, fieldName, val) {
        if (fieldName === 'product') {
            const patternSelect = document.getElementById(`pattern_${pId}`);
            if (val !== 'Свой вариант') {
                const patterns = PATTERNS_MAP[val] || ['Oversize', 'Boxy-fit', 'Regular'];
                let html = '<option value="">Выберите крой...</option>';
                patterns.forEach(p => { html += `<option value="${p}">${p}</option>`; });
                html += '<option value="Свой вариант">+ Свой вариант...</option>';
                patternSelect.innerHTML = html;
            }
        } else if (fieldName === 'fabric') {
            const densitySelect = document.getElementById(`density_${pId}`);
            if (val !== 'Свой вариант') {
                const densities = DENSITIES_MAP[val] || [];
                let html = '<option value="">Выберите плотность...</option>';
                densities.forEach(d => { html += `<option value="${d}">${d}</option>`; });
                html += '<option value="Свой вариант">+ Свой вариант...</option>';
                densitySelect.innerHTML = html;
            }
        }

        if (val === 'Свой вариант') {
            const selectEl = document.getElementById(`${fieldName}_${pId}`);
            const boxEl = document.getElementById(`custom_box_${fieldName}_${pId}`);
            const inputEl = document.getElementById(`custom_${fieldName}_${pId}`);

            selectEl.style.display = 'none';
            selectEl.removeAttribute('name');

            boxEl.style.display = 'flex';
            inputEl.setAttribute('name', `${fieldName}_${pId}`);
            inputEl.value = '';
            inputEl.focus();
        }
    }

    // Возврат от текстового поля обратно к выпадающему списку
    function revertFieldToSelect(pId, fieldName) {
        const selectEl = document.getElementById(`${fieldName}_${pId}`);
        const boxEl = document.getElementById(`custom_box_${fieldName}_${pId}`);
        const inputEl = document.getElementById(`custom_${fieldName}_${pId}`);

        inputEl.removeAttribute('name');
        inputEl.value = '';
        boxEl.style.display = 'none';

        selectEl.setAttribute('name', `${fieldName}_${pId}`);
        selectEl.value = '';
        selectEl.style.display = 'block';
    }

    // Умное позиционирование меню: открывается вверх, если снизу нет места
    function toggleStageMenu(e) {
        e.stopPropagation();
        const btn = e.currentTarget || e.target.closest('button');
        const menu = document.getElementById('stageDropdownMenu');
        if (!menu) return;

        const isOpen = menu.classList.contains('active');
        if (isOpen) {
            menu.classList.remove('active');
            return;
        }

        const rect = btn.getBoundingClientRect();
        const spaceBelow = window.innerHeight - rect.bottom;
        const menuHeight = 280;

        if (spaceBelow < menuHeight && rect.top > menuHeight) {
            menu.style.top = 'auto';
            menu.style.bottom = '100%';
            menu.style.marginTop = '0';
            menu.style.marginBottom = '6px';
        } else {
            menu.style.top = '100%';
            menu.style.bottom = 'auto';
            menu.style.marginTop = '6px';
            menu.style.marginBottom = '0';
        }

        menu.classList.add('active');
    }

    document.addEventListener('click', (e) => {
        const menu = document.getElementById('stageDropdownMenu');
        if (menu && !e.target.closest('#stageDropdownMenu') && !e.target.closest('button[onclick*="toggleStageMenu"]')) {
            menu.classList.remove('active');
        }
    });

    function addStageFromMenu(stageName) {
        document.getElementById('stageDropdownMenu').classList.remove('active');
        addStageRow(stageName);
    }

    function promptCustomStage() {
        document.getElementById('stageDropdownMenu').classList.remove('active');
        const name = prompt('Введите название своего этапа:');
        if (name && name.trim()) {
            addStageRow(name.trim());
        }
    }

    function addStageRow(stageName) {
        const list = document.getElementById('sortable-stages');
        const li = document.createElement('li');
        li.className = 'stage-item-row';
        li.dataset.explicit = 'false';
        li.draggable = true;
        li.innerHTML = `
            <span style="cursor:grab; font-size:16px; color:#6b7280; padding-right:8px;" title="Перетащите для изменения порядка">:::</span>
            <input type="text" name="stage_type[]" value="${stageName}" readonly style="font-weight:600; flex:1; min-width:130px; border:none; background:transparent;">
            <select class="duration-select" onchange="calculateSchedule();" style="width:auto; padding:5px; font-size:13px;">
                <option value="0.25">0.25 дня</option>
                <option value="0.5">0.5 дня</option>
                <option value="0.75">0.75 дня</option>
                <option value="1" selected>1 день</option>
                <option value="2">2 дня</option>
                <option value="3">3 дня</option>
                <option value="4">4 дня</option>
                <option value="5">5 дней</option>
                <option value="6">6 дней</option>
                <option value="7">7 дней</option>
                <option value="custom">Вручную (дни)</option>
            </select>
            <input type="number" class="custom-duration" step="0.25" min="0.25" style="display:none; width:70px; padding:5px;" oninput="calculateSchedule();" placeholder="Дней">
            <button type="button" class="btn btn-outline" style="padding:4px 8px; font-size:12px;" onclick="openIntervalPicker(this)">Интервал</button>
            <span class="stage-dates-display" style="font-size:13px; font-weight:600; margin-left:10px; color:#58a6ff;"></span>
            
            <input type="hidden" name="start_date[]" class="start-date-input">
            <input type="hidden" name="start_q[]" class="start-q-input">
            <input type="hidden" name="end_date[]" class="end-date-input">
            <input type="hidden" name="end_q[]" class="end-q-input">
            <button type="button" class="btn btn-danger" style="padding:3px 7px; font-size:12px; margin-left:auto;" onclick="this.closest('li').remove(); calculateSchedule();">✕</button>
        `;
        list.appendChild(li);
        calculateSchedule();
        clearBatchStageError();
    }

    const sortList = document.getElementById('sortable-stages');
    let draggedStage = null;
    sortList.addEventListener('dragstart', e => {
        draggedStage = e.target.closest('li');
        if (draggedStage) draggedStage.classList.add('dragging');
    });
    sortList.addEventListener('dragend', e => {
        if (draggedStage) {
            draggedStage.classList.remove('dragging');
            draggedStage = null;
            calculateSchedule();
        }
    });
    sortList.addEventListener('dragover', e => {
        e.preventDefault();
        const after = getDragAfterElement(sortList, e.clientY);
        if (e.target.closest('li') !== draggedStage && draggedStage) {
            if (!after) sortList.appendChild(draggedStage);
            else sortList.insertBefore(draggedStage, after);
        }
    });
    function getDragAfterElement(container, y) {
        return [...container.querySelectorAll('li:not(.dragging)')].reduce((closest, child) => {
            const box = child.getBoundingClientRect(), offset = y - box.top - box.height / 2;
            return (offset < 0 && offset > closest.offset) ? { offset: offset, element: child } : closest;
        }, { offset: Number.NEGATIVE_INFINITY }).element;
    }

    function dateToAbs(dateStr, q) { if(!dateStr) return 0; const p = dateStr.split('-'); return Math.floor(new Date(Date.UTC(p[0], p[1]-1, p[2])).getTime()/86400000) * 4 + parseInt(q) - 1; }
    function absToDateAndQ(absQ) { const dStr = new Date(Math.floor(absQ/4) * 86400000).toISOString().split('T')[0]; return { date: dStr, q: (absQ % 4) + 1 }; }
    function formatD(d) { if(!d) return ''; const p = d.split('-'); return `${p[2]}.${p[1]}.${p[0]}`; }

    let dbOccupiedMap = {};
    let localOccupiedMapForPicker = {};

    async function loadOccupiedSlots() {
        const type = document.getElementById('order_type').value;
        const res = await fetch(`/api/occupied?order_type=${type}`);
        const slots = await res.json();
        dbOccupiedMap = {};
        slots.forEach(s => {
            let start = dateToAbs(s.start_date, s.start_q);
            let end = dateToAbs(s.end_date, s.end_q);
            for (let q = start; q <= end; q++) dbOccupiedMap[q] = true;
        });
        if (type === 'sample') calculateSampleSchedule();
        else calculateSchedule();
    }

    // Пункт 5 ТЗ: Автоматический расчет финиша в форме
    function calculateSchedule() {
        let startD = document.getElementById('global-start-date').value;
        let startQ = document.getElementById('global-start-q').value;

        document.querySelectorAll('#sortable-stages li').forEach(row => {
            const sel = row.querySelector('.duration-select').value;
            row.querySelector('.custom-duration').style.display = (sel === 'custom') ? 'inline-block' : 'none';
        });

        if (!startD) return;

        let currentAbsQ = dateToAbs(startD, startQ);
        let localOccupiedMap = {...dbOccupiedMap};
        let lastEndObj = null;

        document.querySelectorAll('#sortable-stages li').forEach(row => {
            const sel = row.querySelector('.duration-select').value;
            let duration = (sel === 'custom') ? parseFloat(row.querySelector('.custom-duration').value || 0) : parseFloat(sel || 0);
            
            if (row.dataset.explicit === 'true') {
                let stA = dateToAbs(row.querySelector('.start-date-input').value, row.querySelector('.start-q-input').value);
                let enA = dateToAbs(row.querySelector('.end-date-input').value, row.querySelector('.end-q-input').value);
                for(let i=stA; i<=enA; i++) localOccupiedMap[i] = true;
                currentAbsQ = Math.max(currentAbsQ, enA + 1);
                lastEndObj = absToDateAndQ(enA);
            } else if (duration > 0) {
                let quartersNeeded = Math.round(duration * 4);
                let stageStartQ = null;
                let stageEndQ = null;
                
                while (quartersNeeded > 0) {
                    if (!localOccupiedMap[currentAbsQ]) {
                        if (stageStartQ === null) stageStartQ = currentAbsQ;
                        stageEndQ = currentAbsQ;
                        quartersNeeded--;
                        localOccupiedMap[currentAbsQ] = true;
                    }
                    currentAbsQ++;
                }
                
                let startObj = absToDateAndQ(stageStartQ);
                let endObj = absToDateAndQ(stageEndQ);
                lastEndObj = endObj;
                
                row.querySelector('.start-date-input').value = startObj.date;
                row.querySelector('.start-q-input').value = startObj.q;
                row.querySelector('.end-date-input').value = endObj.date;
                row.querySelector('.end-q-input').value = endObj.q;
                row.querySelector('.stage-dates-display').textContent = `${formatD(startObj.date)} (ч.${startObj.q}) — ${formatD(endObj.date)} (ч.${endObj.q})`;
            }
        });
        localOccupiedMapForPicker = localOccupiedMap;

        const finishEl = document.getElementById('order-finish-display');
        if (lastEndObj && finishEl) {
            finishEl.textContent = `— Финиш: ${formatD(lastEndObj.date)}, ${lastEndObj.q}-я часть дня`;
            finishEl.style.display = 'inline';
        } else if (finishEl) {
            finishEl.style.display = 'none';
        }
    }

    function calculateSampleSchedule() {
        let startD = document.getElementById('global-start-date').value;
        let startQ = document.getElementById('global-start-q').value;
        let sel = document.getElementById('sample-duration').value;
        if (!startD) return;

        let duration = parseFloat(sel || 0);
        if (duration > 0) {
            let currentAbsQ = dateToAbs(startD, startQ);
            let quartersNeeded = Math.round(duration * 4);
            let stageEndQ = currentAbsQ;
            let localOccupiedMap = {...dbOccupiedMap};
            
            while (quartersNeeded > 0) {
                if (!localOccupiedMap[currentAbsQ]) {
                    stageEndQ = currentAbsQ;
                    quartersNeeded--;
                    localOccupiedMap[currentAbsQ] = true;
                }
                currentAbsQ++;
            }
            
            let endObj = absToDateAndQ(stageEndQ);
            document.getElementById('sample-end-date').value = endObj.date;
            document.getElementById('sample-end-q').value = endObj.q;
            document.getElementById('sample-dates-display').textContent = `${formatD(startD)} (ч.${startQ}) — ${formatD(endObj.date)} (ч.${endObj.q})`;
        }
    }

    function toggleOrderTypeUI() {
        const type = document.getElementById('order_type').value;
        if (type === 'sample') {
            document.getElementById('batch-ui').style.display = 'none';
            document.getElementById('sample-ui').style.display = 'block';
            calculateSampleSchedule();
        } else {
            document.getElementById('batch-ui').style.display = 'block';
            document.getElementById('sample-ui').style.display = 'none';
            calculateSchedule();
        }
    }

    function clearStartDateError() {
        const btn = document.getElementById('start-picker-btn');
        if (btn) btn.classList.remove('field-input-error');
        const group = document.getElementById('group-start-date');
        if (group) {
            const err = group.querySelector('.field-error-text');
            if (err) err.style.display = 'none';
        }
    }

    function clearBatchStageError() {
        const err = document.getElementById('batch-stages-error');
        if (err) err.style.display = 'none';
    }

    let pickerMode = 'start', pickerRow = null, currentMonth = new Date().getMonth(), currentYear = new Date().getFullYear(), selection = []; 
    function openStartPicker() {
        pickerMode = 'start'; selection = [];
        const val = document.getElementById('global-start-date').value;
        if (val) { currentYear = parseInt(val.split('-')[0]); currentMonth = parseInt(val.split('-')[1]) - 1; }
        else { currentMonth = new Date().getMonth(); currentYear = new Date().getFullYear(); }
        document.getElementById('pickerTitle').textContent = 'Начало производства'; 
        document.getElementById('calendarModal').classList.add('active'); 
        renderPicker();
    }
    function openIntervalPicker(btn) {
        pickerMode = 'interval'; pickerRow = btn.closest('li'); selection = [];
        const val = pickerRow.querySelector('.start-date-input').value;
        if (val) { currentYear = parseInt(val.split('-')[0]); currentMonth = parseInt(val.split('-')[1]) - 1; }
        else { currentMonth = new Date().getMonth(); currentYear = new Date().getFullYear(); }
        document.getElementById('pickerTitle').textContent = 'Интервал этапа';
        document.getElementById('calendarModal').classList.add('active'); 
        renderPicker();
    }

    function closePicker() { document.getElementById('calendarModal').classList.remove('active'); }
    function changeMonth(delta) { currentMonth += delta; if (currentMonth < 0) { currentMonth = 11; currentYear--; } if (currentMonth > 11) { currentMonth = 0; currentYear++; } renderPicker(); }

    function renderPicker() {
        document.getElementById('pickerMonthYear').textContent = ['Январь','Февраль','Март','Апрель','Май','Июнь','Июль','Август','Сентябрь','Октябрь','Ноябрь','Декабрь'][currentMonth] + ' ' + currentYear;
        const container = document.getElementById('pickerGrid'), firstDay = new Date(currentYear, currentMonth, 1).getDay(), daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();
        let html = ''; for (let i = 0; i < ((firstDay === 0) ? 6 : firstDay - 1); i++) html += '<div></div>';
        
        for (let d = 1; d <= daysInMonth; d++) {
            const dateStr = `${currentYear}-${String(currentMonth+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
            let qHtml = '';
            for (let q = 1; q <= 4; q++) {
                const cAbs = dateToAbs(dateStr, q);
                let isOcc = (pickerMode === 'start') ? dbOccupiedMap[cAbs] : localOccupiedMapForPicker[cAbs];
                let isSelected = (selection.length===1) ? (cAbs===dateToAbs(selection[0].date, selection[0].q)) : (selection.length===2 && cAbs>=Math.min(dateToAbs(selection[0].date, selection[0].q), dateToAbs(selection[1].date, selection[1].q)) && cAbs<=Math.max(dateToAbs(selection[0].date, selection[0].q), dateToAbs(selection[1].date, selection[1].q)));
                qHtml += `<div class="q-block ${isOcc?'occupied':''} ${isSelected?'selected':''}" onclick="onQClick('${dateStr}', ${q}, ${isOcc})"></div>`;
            }
            html += `<div class="day-cell-picker"><div style="font-size:12px; margin-bottom:2px; text-align:center;">${d}</div><div class="q-grid">${qHtml}</div></div>`;
        }
        container.innerHTML = html;
    }

    function onQClick(dateStr, q, isOcc) {
        if (isOcc) return; 
        if (pickerMode === 'start') selection = [{date: dateStr, q: q}];
        else {
            if (selection.length === 0 || selection.length === 2) selection = [{date: dateStr, q: q}];
            else {
                const s0Abs = dateToAbs(selection[0].date, selection[0].q), s1Abs = dateToAbs(dateStr, q);
                for(let a = Math.min(s0Abs, s1Abs); a <= Math.max(s0Abs, s1Abs); a++) {
                    if (localOccupiedMapForPicker[a]) return alert("Пересечение с занятым временем!");
                }
                selection = (s1Abs < s0Abs) ? [{date: dateStr, q: q}, selection[0]] : [selection[0], {date: dateStr, q: q}];
            }
        }
        renderPicker();
    }

    function applyPicker() {
        if (selection.length === 0) return alert('Выберите время');
        if (pickerMode === 'start') {
            document.getElementById('global-start-date').value = selection[0].date; 
            document.getElementById('global-start-q').value = selection[0].q;
            document.getElementById('order-start-display').textContent = `Старт: ${formatD(selection[0].date)}, ${selection[0].q}-я часть дня`; 
            clearStartDateError();

            if (document.getElementById('order_type').value === 'sample') calculateSampleSchedule();
            else calculateSchedule();
        } else {
            if (selection.length !== 2) selection.push(selection[0]);
            const row = pickerRow, st = selection[0], en = selection[1];
            row.dataset.explicit = 'true'; 
            row.querySelector('.duration-select').value = ''; 
            row.querySelector('.custom-duration').style.display = 'none';
            row.querySelector('.start-date-input').value = st.date; 
            row.querySelector('.start-q-input').value = st.q;
            row.querySelector('.end-date-input').value = en.date; 
            row.querySelector('.end-q-input').value = en.q;
            row.querySelector('.stage-dates-display').textContent = `${formatD(st.date)} (ч.${st.q}) — ${formatD(en.date)} (ч.${en.q})`; 
            calculateSchedule();
        }
        closePicker();
    }

    // Пункт 4 ТЗ: В окне сводки выводим нанесения и финиш
    function openOrderSummaryModal() {
        let isValid = true;
        let firstInvalid = null;

        const nameInput = document.getElementById('order-name');
        if (!nameInput.value.trim()) {
            nameInput.classList.add('field-input-error');
            const group = document.getElementById('group-name');
            if (group) group.querySelector('.field-error-text').style.display = 'block';
            isValid = false;
            if (!firstInvalid) firstInvalid = nameInput;
        }

        const clientInput = document.getElementById('client_name');
        if (!clientInput.value.trim()) {
            clientInput.classList.add('field-input-error');
            isValid = false;
            if (!firstInvalid) firstInvalid = clientInput;
        }

        const startD = document.getElementById('global-start-date').value;
        const startQ = document.getElementById('global-start-q').value;
        if (!startD || !startQ) {
            const btn = document.getElementById('start-picker-btn');
            btn.classList.add('field-input-error');
            const group = document.getElementById('group-start-date');
            if (group) group.querySelector('.field-error-text').style.display = 'block';
            isValid = false;
            if (!firstInvalid) firstInvalid = btn;
        }

        const type = document.getElementById('order_type').value;
        if (type === 'batch') {
            const rows = document.querySelectorAll('#sortable-stages li');
            if (!rows.length) {
                const err = document.getElementById('batch-stages-error');
                if (err) err.style.display = 'block';
                isValid = false;
                if (!firstInvalid) firstInvalid = document.getElementById('sortable-stages');
            }
        }

        if (!isValid) {
            if (firstInvalid) firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
            return;
        }

        const num = document.getElementById('order_number').value;
        const name = nameInput.value.trim();
        const client = clientInput.value.trim();
        const dateCreated = document.getElementById('creation_date').value;
        const amount = document.getElementById('order_amount').value || 0;
        const comment = document.getElementById('order-comment').value.trim();
        const totalQty = document.getElementById('total-order-qty').textContent;

        let positionsHtml = '';
        document.querySelectorAll('.position-card').forEach((c, idx) => {
            const pId = c.dataset.pid;
            const prod = c.querySelector(`[name="product_${pId}"]`).value;
            const pat = c.querySelector(`[name="pattern_${pId}"]`).value;
            const fab = c.querySelector(`[name="fabric_${pId}"]`).value;
            const den = c.querySelector(`[name="density_${pId}"]`).value;
            const col = c.querySelector(`[name="color_${pId}"]`).value;
            const posQty = c.querySelector(`#pos-total-display-${pId}`).textContent;

            // Нанесения позиции для сводки
            let embList = [];
            c.querySelectorAll('.emb-row').forEach(er => {
                const et = er.querySelector(`[name="emb_type_${pId}[]"]`).value;
                const ef = er.querySelector(`[name="emb_format_${pId}[]"]`).value;
                const eq = er.querySelector(`[name="emb_quantity_${pId}[]"]`).value;
                embList.push(`${et} (${ef}) — ${eq} шт.`);
            });

            positionsHtml += `
                <div style="background:rgba(255,255,255,0.03); border:1px solid #30363d; border-radius:6px; padding:10px; margin-bottom:8px;">
                    <div style="font-weight:600; color:#58a6ff; margin-bottom:4px;">Позиция #${idx+1}: ${prod || '—'} (${posQty})</div>
                    <div style="font-size:12px; color:#8b949e;">
                        <strong>Крой:</strong> ${pat || '—'} | <strong>Полотно:</strong> ${fab || '—'} | <strong>Плотность:</strong> ${den || '—'} | <strong>Цвет:</strong> ${col || '—'}
                    </div>
                    ${embList.length ? `<div style="font-size:12px; margin-top:4px; color:#f59e0b;"><strong>Нанесения:</strong> ${embList.join(', ')}</div>` : ''}
                </div>
            `;
        });

        let stagesHtml = '';
        let lastEndText = '';
        document.querySelectorAll('#sortable-stages li').forEach(s => {
            const sName = s.querySelector('input[name="stage_type[]"]').value;
            const sDates = s.querySelector('.stage-dates-display').textContent;
            stagesHtml += `<li><strong>${sName}:</strong> ${sDates}</li>`;
            lastEndText = s.querySelector('.end-date-input').value;
        });

        const finishDisplay = document.getElementById('order-finish-display').textContent;

        const summaryHtml = `
            <div style="margin-bottom:15px; background:rgba(37,99,235,0.06); padding:12px; border-radius:6px;">
                <div style="font-size:16px; font-weight:700; margin-bottom:6px;">Заказ #${num} — ${name}</div>
                <div><strong>Клиент / Бренд:</strong> ${client}</div>
                <div><strong>Дата оформления:</strong> ${formatD(dateCreated)}</div>
                <div><strong>Сумма заказа:</strong> ${amount} ₽</div>
                <div><strong>Общий тираж:</strong> ${totalQty} шт.</div>
                ${comment ? `<div><strong>Комментарий:</strong> ${comment}</div>` : ''}
            </div>

            <h4 style="margin-bottom:8px;">Состав изделий:</h4>
            ${positionsHtml || '<p style="color:#8b949e;">Позиции не добавлены</p>'}

            <h4 style="margin-top:15px; margin-bottom:8px;">График производства:</h4>
            <div style="margin-bottom:6px;">
                <strong>${document.getElementById('order-start-display').textContent}</strong> 
                ${finishDisplay ? `<span style="color:#58a6ff; font-weight:600;"> ${finishDisplay}</span>` : ''}
            </div>
            <ul style="padding-left:20px; margin:0;">${stagesHtml}</ul>
        `;

        document.getElementById('summaryContent').innerHTML = summaryHtml;
        document.getElementById('summaryModal').classList.add('active');
    }

    function closeSummaryModal() {
        document.getElementById('summaryModal').classList.remove('active');
    }

    function submitOrderFormFinal() {
        isOrderSubmitted = true;
        document.getElementById('orderForm').submit();
    }

    // Живое автосохранение черновика и восстановление
    let currentDraftId = new URLSearchParams(window.location.search).get('draft_id') || null;
    let isOrderSubmitted = false;
    let autoSaveTimer = null;

    if (currentDraftId) {
        const inp = document.getElementById('loaded_draft_id');
        if (inp) inp.value = currentDraftId;
    }

    function hasAnyFormData() {
        const name = (document.getElementById('order-name') ? document.getElementById('order-name').value.trim() : '');
        const client = (document.getElementById('client_name') ? document.getElementById('client_name').value.trim() : '');
        const comment = (document.getElementById('order-comment') ? document.getElementById('order-comment').value.trim() : '');
        const contact = (document.getElementById('contact_input') ? document.getElementById('contact_input').value.trim() : '');
        const amount = (document.getElementById('order_amount') ? parseFloat(document.getElementById('order_amount').value) || 0 : 0);
        const stagesCount = document.querySelectorAll('#sortable-stages li').length;
        const totalQty = parseInt(document.getElementById('total-order-qty').textContent, 10) || 0;

        let hasSelectedOption = false;
        document.querySelectorAll('.position-card select').forEach(s => {
            if (s.value) hasSelectedOption = true;
        });

        return Boolean(name || client || comment || contact || amount > 0 || stagesCount > 0 || totalQty > 0 || hasSelectedOption);
    }

    function getDraftTitle() {
        const name = (document.getElementById('order-name') ? document.getElementById('order-name').value.trim() : '');
        const client = (document.getElementById('client_name') ? document.getElementById('client_name').value.trim() : '');
        const num = (document.getElementById('order_number') ? document.getElementById('order_number').value : '');
        if (name) return name;
        if (client) return 'Заказ ' + client;
        return 'Черновик #' + (num || '1');
    }

    function serializeFormState() {
        const formEl = document.getElementById('orderForm');
        const formData = new FormData(formEl);
        const fields = {};
        for (let [k, v] of formData.entries()) {
            if (k !== 'order_files' && k !== 'loaded_draft_id' && !k.startsWith('pos_files_')) {
                if (k.endsWith('[]')) {
                    if (!fields[k]) fields[k] = [];
                    fields[k].push(v);
                } else {
                    fields[k] = v;
                }
            }
        }
        return fields;
    }

    async function saveCurrentAsDraft(isSilent = false) {
        if (isOrderSubmitted) return;
        if (!hasAnyFormData()) {
            if (!isSilent) alert('Форма пуста, сохранять нечего.');
            return;
        }

        const draftObj = {
            draft_id: currentDraftId,
            title: getDraftTitle(),
            fields: serializeFormState()
        };

        const payload = JSON.stringify(draftObj);

        try {
            const res = await fetch('/api/drafts', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: payload,
                keepalive: true
            });
            const data = await res.json();
            if (data && data.success) {
                currentDraftId = data.draft_id;
                const inp = document.getElementById('loaded_draft_id');
                if (inp) inp.value = currentDraftId;
                if (!isSilent) alert('Черновик сохранён!');
            }
        } catch(e) {
            if (!isSilent) alert('Ошибка при сохранении черновика');
        }
    }

    function scheduleAutoSave() {
        if (isOrderSubmitted) return;
        clearTimeout(autoSaveTimer);
        autoSaveTimer = setTimeout(() => {
            if (hasAnyFormData()) {
                saveCurrentAsDraft(true);
            }
        }, 1000);
    }

    document.addEventListener('DOMContentLoaded', () => {
        loadOccupiedSlots();
        addPositionCard();

        const formEl = document.getElementById('orderForm');
        if (formEl) {
            formEl.addEventListener('input', scheduleAutoSave);
            formEl.addEventListener('change', scheduleAutoSave);
        }

        document.addEventListener('click', (e) => {
            const link = e.target.closest('a');
            if (link && link.href && !link.target && !link.hasAttribute('download')) {
                if (!isOrderSubmitted && hasAnyFormData()) {
                    saveCurrentAsDraft(true);
                }
            }
        });

        document.addEventListener('visibilitychange', () => {
            if (document.visibilityState === 'hidden' && !isOrderSubmitted && hasAnyFormData()) {
                saveCurrentAsDraft(true);
            }
        });
        window.addEventListener('pagehide', () => {
            if (!isOrderSubmitted && hasAnyFormData()) {
                saveCurrentAsDraft(true);
            }
        });

        setTimeout(loadDraftIfPresent, 250);
    });

    async function loadDraftIfPresent() {
        if (!currentDraftId) return;
        try {
            const res = await fetch('/api/drafts/' + currentDraftId);
            const draft = await res.json();
            if (!draft || !draft.data_json) return;
            const data = JSON.parse(draft.data_json);
            const f = data.fields || {};

            if (f.order_number) document.getElementById('order_number').value = f.order_number;
            if (f.name) document.getElementById('order-name').value = f.name;
            if (f.client_name) document.getElementById('client_name').value = f.client_name;
            if (f.creation_date) document.getElementById('creation_date').value = f.creation_date;
            if (f.amount) document.getElementById('order_amount').value = f.amount;
            if (f.order_type) {
                document.getElementById('order_type').value = f.order_type;
                toggleOrderTypeUI();
            }
            if (f.contact) document.getElementById('contact_input').value = f.contact;
            if (f.comment) document.getElementById('order-comment').value = f.comment;
            if (f.order_start_date) {
                document.getElementById('global-start-date').value = f.order_start_date;
                document.getElementById('global-start-q').value = f.order_start_q || 1;
                document.getElementById('order-start-display').textContent = `Старт: ${formatD(f.order_start_date)}, ${f.order_start_q || 1}-я часть дня`;
            }
        } catch(e) {}
    }
</script>
{% endblock %}
